# Copy this file to frontend/.env.local (ignored by Git). See docs/supabase-auth.md.

# Your Supabase project URL, the same value as SUPABASE_URL in backend/.env.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The project's publishable (anon) key, from Project Settings -> API Keys.
# It is public by design and ends up in the browser bundle. Never put the
# secret / service_role key, the JWT secret or the database password here.
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Optional: the backend address. Defaults to http://localhost:8000.
# VITE_API_BASE_URL=http://localhost:8000

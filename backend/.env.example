# Copy this file to .env and fill in your real Supabase connection string.
# In Supabase: Project Settings -> Database -> Connection Pooling, then copy the
# Transaction mode URI (port 6543). The direct host can be IPv6-only and time out.
# Replace YOUR_PASSWORD, YOUR_PROJECT_REF and YOUR_REGION with your own values.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Get a key at https://console.anthropic.com/settings/keys
# Required for the AI code review feature (Stage 4). Without it, code review
# submissions will still save but the review_status will be "failed".
ANTHROPIC_API_KEY=your_anthropic_api_key_here

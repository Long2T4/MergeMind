# Copy this file to .env and fill in your real Supabase connection string.
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD] with your actual database password (no brackets).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Get a key at https://console.anthropic.com/settings/keys
# Required for the AI code review feature (Stage 4). Without it, code review
# submissions will still save but the review_status will be "failed".
ANTHROPIC_API_KEY=your_anthropic_api_key_here
